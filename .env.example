# Copy this file to `.env` and fill it in. `.env` is git-ignored; this template
# holds names only. On Netlify, add the same names under
# Site configuration -> Environment variables.
#
# Only names starting with VITE_ reach the browser. Everything else stays on
# the server (the API / Netlify Function).

# Database (MongoDB Atlas) - database name is tos_portal
MONGODB_URI=

# File uploads (Cloudinary dashboard -> API keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Continue with Google (Google Cloud Console -> Credentials -> OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs login cookies - any long random string (32+ characters)
SESSION_SECRET=

# /delealone owner area - both passwords are needed to enter
DELEALONE_PASSWORD_1=
DELEALONE_PASSWORD_2=

# Background notifications. Generate once with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Nexus AI chat bubble (openrouter.ai -> Keys). CHAT_MODEL is optional.
OPENROUTER_API_KEY=
CHAT_MODEL=

# The deployed address, e.g. https://your-site.netlify.app (empty for local dev)
APP_URL=
